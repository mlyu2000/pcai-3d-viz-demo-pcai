# Place the map PNGs (albedo/height/normal/roughness/metallic) in the same
# folder as this script. If model.obj is present (image-derived geometry),
# it is imported and used as the object; otherwise the procedural SHAPE
# (cup | dog | wood) is built.
#
# Two variants side by side, so the material maps' effects are easy to A/B:
#   *_Albedo  — full PBR material (albedo + normal + roughness + metallic)
#   *_Relief  — same, plus the height map driving a Bump node
# All non-color maps (normal/height/roughness/metallic) are set to Non-Color.
import bpy, os, bmesh
from math import cos, sin, pi, radians
from mathutils import Euler

HERE = os.path.dirname(os.path.abspath(__file__))
HEIGHT_SCALE = __HEIGHT_SCALE__
OUT_NAME    = "__OUT_NAME__"
SHAPE       = "__SHAPE__"
HAS_MODEL   = __HAS_MODEL__   # True -> import model.obj (image-derived geometry)
HAS_GLB     = __HAS_GLB__     # True -> import model.glb (REAL 3D, baked PBR)

# ---------------------------------------------------------------------------
# Part helpers (version-robust bmesh; no bpy.ops.object.join — it is
# unreliable in background mode).
# ---------------------------------------------------------------------------
def _merge_into(dst, src):
    """Merge a part bmesh into dst (via a temporary mesh)."""
    m = bpy.data.meshes.new("_part")
    src.to_mesh(m)
    src.free()
    dst.from_mesh(m)
    bpy.data.meshes.remove(m)

def _part_uvsphere(bm, r, loc, scale=None, segments=32, rings=16):
    tmp = bmesh.new()
    # Blender 5.x renamed the keywords (u_segments/v_segments, no cap_ends);
    # 4.x uses segments/ring_count/cap_ends. Probe at runtime so one template
    # works on both.
    try:
        bmesh.ops.create_uvsphere(tmp, u_segments=segments, v_segments=rings,
                                  radius=r)
    except TypeError:
        bmesh.ops.create_uvsphere(tmp, cap_ends=True, segments=segments,
                                  ring_count=rings, radius=r)
    if scale:
        # Blender 5.x renamed the keywords: bmesh.ops.scale(x,y,z) [4.x] vs
        # bmesh.ops.scale(vec=) [5.x]. Probe at runtime so one template works
        # on both.
        try:
            bmesh.ops.scale(tmp, verts=tmp.verts,
                            x=scale[0], y=scale[1], z=scale[2])
        except TypeError:
            bmesh.ops.scale(tmp, verts=tmp.verts,
                            vec=(scale[0], scale[1], scale[2]))
    bmesh.ops.translate(tmp, verts=tmp.verts, vec=loc)
    _merge_into(bm, tmp)

def _part_cone(bm, r1, r2, depth, loc, rot_euler=None, segments=24):
    """Cone (radius1 at -Z base -> radius2 at +Z tip), rotated then placed."""
    tmp = bmesh.new()
    bmesh.ops.create_cone(tmp, cap_ends=True, cap_tris=False, segments=segments,
                          radius1=r1, radius2=r2, depth=depth)
    if rot_euler:
        bmesh.ops.rotate(tmp, verts=tmp.verts, cent=(0, 0, 0),
                         matrix=Euler(rot_euler, "XYZ").to_matrix())
    bmesh.ops.translate(tmp, verts=tmp.verts, vec=loc)
    _merge_into(bm, tmp)

# ---------------------------------------------------------------------------
# CUP — revolved profile + half-torus handle (the proven v4 shape).
# ---------------------------------------------------------------------------
CUP_PROFILE = [
    (0.00, 0.00), (0.50, 0.00), (0.52, 0.06), (0.60, 0.95), (0.60, 1.00),
    (0.54, 1.00), (0.52, 0.95), (0.46, 0.12), (0.42, 0.08), (0.00, 0.08),
]
SPIN_SEGS = 96
TWO_PI = 6.28318530718
PI = 3.14159265359

def _cup_body_bm(bm):
    vs = [bm.verts.new((r, 0.0, h)) for (r, h) in CUP_PROFILE]
    es = [bm.edges.new((vs[i], vs[i + 1])) for i in range(len(vs) - 1)]
    bmesh.ops.spin(bm, geom=vs + es, cent=(0, 0, 0), axis=(0, 0, 1),
                   angle=TWO_PI, steps=SPIN_SEGS, use_merge=True)

def _cup_handle_bm(bm):
    R, r = 0.22, 0.05
    cx, cz = 0.5, 0.5
    maj, mn = 48, 12
    grid = []
    for i in range(maj + 1):
        theta = -PI / 2 + PI * (i / maj)
        ring = []
        for j in range(mn):
            phi = TWO_PI * (j / mn)
            x = cx + (R + r * cos(phi)) * cos(theta)
            y = r * sin(phi)
            z = cz + (R + r * cos(phi)) * sin(theta)
            ring.append(bm.verts.new((x, y, z)))
        grid.append(ring)
    for i in range(maj):
        for j in range(mn):
            a = grid[i][j];      b = grid[i][(j + 1) % mn]
            c = grid[i + 1][(j + 1) % mn]; d = grid[i + 1][j]
            bm.faces.new((a, b, c, d))

def _build_cup(bm):
    _cup_body_bm(bm)
    _cup_handle_bm(bm)

# ---------------------------------------------------------------------------
# DOG — recognizable low-poly quadruped: elongated raised barrel torso (so the
# legs are visible, not buried), rounded chest + haunch, a neck, a head with a
# muzzle + nose, two ears, four legs with paws, and an upturned tail. Parts
# intersect on purpose — it is a stylized solid, not a watertight sculpt.
# ---------------------------------------------------------------------------
def _build_dog(bm):
    # Torso: elongated barrel along X, raised (bottom ~z=0.44) so the legs show.
    _part_uvsphere(bm, 1.0, (0.0, 0.0, 0.74), scale=(0.60, 0.33, 0.30), segments=48, rings=24)
    # Chest: rounded bulk at the front (slightly lower than the back).
    _part_uvsphere(bm, 1.0, (0.34, 0.0, 0.62), scale=(0.30, 0.29, 0.26), segments=32, rings=16)
    # Haunch: rounded hindquarter at the back.
    _part_uvsphere(bm, 1.0, (-0.42, 0.0, 0.64), scale=(0.27, 0.28, 0.27), segments=32, rings=16)
    # Neck: tapered, tilted up-and-forward, bridging torso and head.
    _part_cone(bm, 0.19, 0.15, 0.40, (0.54, 0.0, 0.92), rot_euler=(0.0, radians(35), 0.0), segments=20)
    # Head: rounded, clearly separate from the body.
    _part_uvsphere(bm, 0.25, (0.80, 0.0, 1.05), scale=(1.05, 0.95, 0.95), segments=32, rings=16)
    # Muzzle: tapered cylinder pointing forward (+X) and slightly down.
    _part_cone(bm, 0.11, 0.08, 0.32, (1.02, 0.0, 1.02), rot_euler=(0.0, radians(95), 0.0), segments=20)
    # Nose: small round tip at the end of the muzzle.
    _part_uvsphere(bm, 0.06, (1.16, 0.0, 0.99), scale=(1.0, 0.9, 0.9), segments=16, rings=8)
    # Ears: pointed flaps on top-back of the head, tilted outward.
    _part_cone(bm, 0.09, 0.02, 0.30, (0.70,  0.16, 1.17), rot_euler=(radians(-24), 0.0, 0.0), segments=16)
    _part_cone(bm, 0.09, 0.02, 0.30, (0.70, -0.16, 1.17), rot_euler=(radians(24), 0.0, 0.0), segments=16)
    # Four legs (front under the chest, back under the haunch) + paws.
    for lx, ly, lr, fwd in ((0.36, 0.18, 0.060, 0.02), (0.36, -0.18, 0.060, 0.02),
                            (-0.42, 0.20, 0.070, -0.02), (-0.42, -0.20, 0.070, -0.02)):
        _part_cone(bm, lr, lr, 0.60, (lx, ly, 0.30), segments=16)
        _part_uvsphere(bm, 0.085, (lx + fwd, ly, 0.05), scale=(1.35, 1.0, 0.7), segments=16, rings=8)
    # Tail: rounded base at the rump + a thickened, up-and-back raised tail
    # (clearly readable, not a thin spike).
    _part_cone(bm, 0.11, 0.09, 0.18, (-0.50, 0.0, 0.82), rot_euler=(0.0, radians(-35), 0.0), segments=16)
    _part_cone(bm, 0.09, 0.045, 0.50, (-0.62, 0.0, 0.96), rot_euler=(0.0, radians(-32), 0.0), segments=16)
    _part_uvsphere(bm, 0.06, (-0.76, 0.0, 1.18), scale=(1.0, 0.9, 0.9), segments=16, rings=8)

# ---------------------------------------------------------------------------
# WOOD — beveled slab: rounded-rectangle outline extruded to plank thickness,
# edges beveled so the grain texture wraps a believable piece of timber.
# ---------------------------------------------------------------------------
def _rounded_rect_points(w, d, r, arc_steps=5):
    """Counter-clockwise outline of a rounded rectangle centred at the origin
    (start: right end of the bottom edge, going around the perimeter)."""
    hw, hd = w / 2.0, d / 2.0
    pts = [(hw - r, -hd)]  # start: bottom edge, just before the bottom-right arc
    arcs = [  # (corner centre, start angle) — each arc sweeps +90°
        ( hw - r, -hd + r, -pi / 2.0),    # bottom-right: -90 -> 0
        ( hw - r,  hd - r, 0.0),          # top-right: 0 -> 90
        (-hw + r,  hd - r, pi / 2.0),     # top-left: 90 -> 180
        (-hw + r, -hd + r, pi),           # bottom-left: 180 -> 270
    ]
    for cx, cy, a0 in arcs:
        for s in range(1, arc_steps + 1):
            a = a0 + (pi / 2.0) * (s / arc_steps)
            pts.append((cx + r * cos(a), cy + r * sin(a)))
    return pts

def _build_wood(bm):
    w, d, r, thick = 1.9, 0.75, 0.12, 0.28
    pts = _rounded_rect_points(w, d, r)
    vs = [bm.verts.new((x, y, 0.0)) for (x, y) in pts]
    face = bm.faces.new(vs)
    res = bmesh.ops.extrude_face_region(bm, geom=[face])
    new_vs = [g for g in res["geom"] if isinstance(g, bmesh.types.BMVert)]
    bmesh.ops.translate(bm, verts=new_vs, vec=(0.0, 0.0, thick))
    # Center the slab on the origin (it sits flat, thickness along Z).
    bmesh.ops.translate(bm, verts=bm.verts, vec=(0.0, 0.0, -thick / 2.0))
    # Bevel all edges for a rounded timber edge (cosmetic; skip if it fails).
    try:
        bmesh.ops.bevel(bm, geom=list(bm.edges), offset=0.035, segments=2,
                        profile=0.5, affect="EDGES")
    except Exception:
        pass

def _part_box(bm, size, loc):
    """Axis-aligned box (size = (x, y, z)), placed at loc. Cube -> scale probe."""
    tmp = bmesh.new()
    bmesh.ops.create_cube(tmp, size=1.0)
    try:
        bmesh.ops.scale(tmp, verts=tmp.verts,
                        x=size[0], y=size[1], z=size[2])
    except TypeError:
        bmesh.ops.scale(tmp, verts=tmp.verts,
                        vec=(size[0], size[1], size[2]))
    bmesh.ops.translate(tmp, verts=tmp.verts, vec=loc)
    _merge_into(bm, tmp)

