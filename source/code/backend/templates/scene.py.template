# HAT — wide flat brim + domed crown (stylized, recognizable silhouette).
# ---------------------------------------------------------------------------
def _build_hat(bm):
    # Brim: a short wide cylinder (flat disc with thickness) sitting at z≈0.
    _part_cone(bm, 0.75, 0.75, 0.06, (0.0, 0.0, 0.03), segments=48)
    # Crown: domed sphere above the brim (slightly flattened vertically).
    _part_uvsphere(bm, 0.55, (0.0, 0.0, 0.55), scale=(1.0, 1.0, 0.9), segments=40, rings=20)

# ---------------------------------------------------------------------------
# CAR — low-poly roadster: body box + raised cabin + 4 wheels. Faces +X.
# ---------------------------------------------------------------------------
def _build_car(bm):
    # Body: long, low box (x=length, y=width, z=height), centred at z=0.35.
    _part_box(bm, (1.9, 0.8, 0.45), (0.0, 0.0, 0.35))
    # Cabin: shorter, narrower box sitting on top, slightly forward.
    _part_box(bm, (0.9, 0.7, 0.4), (0.10, 0.0, 0.70))
    # Four wheels: short cylinders under the body (axle along Y = side-to-side).
    for wx, wy in ((0.62, 0.40), (0.62, -0.40), (-0.62, 0.40), (-0.62, -0.40)):
        _part_cone(bm, 0.16, 0.16, 0.10, (wx, wy, 0.16),
                   rot_euler=(radians(90), 0.0, 0.0), segments=20)

SHAPE_BUILDERS = {"cup": _build_cup, "dog": _build_dog, "wood": _build_wood,
                  "hat": _build_hat, "car": _build_car}
if SHAPE not in SHAPE_BUILDERS:
    SHAPE = "cup"

# Remove the default "Cube" that ships with Blender's startup file so the pack
# opens clean (only the two object variants).
if "Cube" in bpy.data.objects:
    bpy.data.objects.remove(bpy.data.objects["Cube"], do_unlink=True)

def _import_model_obj(name, x_offset):
    """Import model.obj (image-derived geometry) and return the object placed
    at x_offset. Blender 4.2+ uses wm.obj_import; 4.0/4.1 use import_obj.
    The OBJ is Y-up (x right, y up, z relief toward camera) — the default
    import keeps that frame, which reads as an upright, front-facing object."""
    obj_path = os.path.join(HERE, "model.obj")
    before = set(bpy.data.objects)
    try:
        bpy.ops.wm.obj_import(filepath=obj_path)  # Blender 4.2+
    except Exception:
        bpy.ops.import_obj(filepath=obj_path)     # Blender 4.0/4.1
    new = [o for o in set(bpy.data.objects) - before if o.type == "MESH"]
    if not new:
        raise RuntimeError("model.obj import produced no mesh")
    ob = new[0]
    ob.name = name
    ob.location = (x_offset, 0.0, 0.0)
    # The OBJ carries its own UVs (0..1 onto the albedo) — leave them.
    for pg in ob.data.polygons:
        pg.use_smooth = True
    return ob


def _import_model_glb(name, x_offset):
    """Import model.glb (REAL 3D — Hunyuan3D-2.1) and keep its baked PBR
    materials (base color / normal / metallic / roughness come from the GLB
    with matching UVs — re-applying the flat procedural maps would use the
    wrong UVs and look wrong). Blender 4.x/5.x uses wm.gltf_import; older
    Blender uses the import_scene.gltf addon. All new meshes are centered at
    x_offset and smooth-shaded."""
    glb_path = os.path.join(HERE, "model.glb")
    before = set(bpy.data.objects)
    try:
        bpy.ops.wm.gltf_import(filepath=glb_path)      # Blender 4.x / 5.x
    except Exception:
        bpy.ops.import_scene.gltf(filepath=glb_path)    # older Blender
    new = [o for o in set(bpy.data.objects) - before if o.type == "MESH"]
    if not new:
        raise RuntimeError("model.glb import produced no mesh")
    for ob in new:
        ob.location = (x_offset, 0.0, 0.0)
        for pg in ob.data.polygons:
            pg.use_smooth = True
    new[0].name = name
    return new[0]


def _build_shape(name, x_offset, relief):
    """Build the procedural SHAPE object at x_offset (cup/dog/wood)."""
    bm = bmesh.new()
    SHAPE_BUILDERS[SHAPE](bm)
    bmesh.ops.remove_doubles(bm, verts=bm.verts, dist=0.0001)
    me = bpy.data.meshes.new(name)
    bm.to_mesh(me)
    bm.free()
    for pg in me.polygons:
        pg.use_smooth = True
    ob = bpy.data.objects.new(name, me)
    bpy.context.collection.objects.link(ob)
    _uv_unwrap(ob)
    _subdiv(ob, 3 if relief else 1)  # SIMPLE subdivision: density for the
    ob.location = (x_offset, 0.0, 0.0)  # bump/relief to show
    return ob

def _uv_unwrap(ob):
    if not ob.data.uv_layers:
        ob.data.uv_layers.new(name="UVMap")
    for o in bpy.context.selected_objects:
        o.select_set(False)
    ob.select_set(True)
    bpy.context.view_layer.objects.active = ob
    try:
        bpy.ops.object.mode_set(mode="EDIT")
        bpy.ops.mesh.select_all(action="SELECT")
        bpy.ops.uv.smart_project(angle_limit=1.15192, island_margin=0.02)
        bpy.ops.object.mode_set(mode="OBJECT")
    except Exception:
        pass

def _subdiv(ob, levels):
    m = ob.modifiers.new("Subsurf", "SUBSURF")
    m.subdivision_type = "SIMPLE"
    m.levels = levels
    m.render_levels = levels
    return m

# ---------------------------------------------------------------------------
# PBR material (brief Stage 3): wire ALL maps into the Principled BSDF and set
# the data maps (normal/height/roughness/metallic) to Non-Color.
# ---------------------------------------------------------------------------
def _load_img(fn):
    """Load a map PNG from the pack folder, reusing an already-loaded copy so
    each file maps to a SINGLE image datablock. Both materials (Base + Relief)
    share the same map files; without this, the 2nd `images.load()` of the same
    file creates a duplicate datablock Blender auto-suffixes (albedo.png.001)
    that the pack loop would miss, leaving an unpacked external ref that breaks
    the .blend on another machine. Packed into the .blend later."""
    p = os.path.join(HERE, fn)
    if not os.path.isfile(p):
        return None
    for img in bpy.data.images:
        if os.path.basename(img.filepath) == fn:
            return img
    return bpy.data.images.load(p)


def _new_mat(name, use_height):
    m = bpy.data.materials.new(name)
    # `Material.use_nodes` is deprecated in Blender 5.x (removed in 6.0) and
    # emits a warning. Build the node tree directly so one template works on
    # 4.x, 5.x, and 6.x without the warning.
    if getattr(m, "node_tree", None) is None:
        nt = bpy.data.node_groups.new(name + "_nt", "ShaderNodeTree")
        m.node_tree = nt
    bsdf = m.node_tree.nodes.get("Principled BSDF")
    if bsdf is None:
        bsdf = m.node_tree.nodes.new("ShaderNodeBsdfPrincipled")
        bsdf.name = "Principled BSDF"
        out = m.node_tree.nodes.new("ShaderNodeOutputMaterial")
        out.name = "Material Output"
        m.node_tree.links.new(bsdf.outputs["BSDF"], out.inputs["Surface"])
    nt = m.node_tree

    def _tex(fn, non_color):
        img = _load_img(fn)
        if img is None:
            return None
        t = nt.nodes.new("ShaderNodeTexImage")
        t.image = img
        if non_color:
            t.image.colorspace_settings.name = "Non-Color"
        return t

    # Base color: albedo (sRGB — leave the colorspace at sRGB/Default).
    t_alb = _tex("albedo.png", non_color=False)
    if t_alb:
        nt.links.new(t_alb.outputs["Color"], bsdf.inputs["Base Color"])

    # Normal: normal.png -> NormalMap node -> BSDF Normal (Non-Color).
    t_nrm = _tex("normal.png", non_color=True)
    if t_nrm:
        nm = nt.nodes.new("ShaderNodeNormalMap")
        nm.inputs["Strength"].default_value = 1.0
        nt.links.new(t_nrm.outputs["Color"], nm.inputs["Color"])
        nt.links.new(nm.outputs["Normal"], bsdf.inputs["Normal"])

    # Roughness: roughness.png -> BSDF Roughness (Non-Color).
    t_rgh = _tex("roughness.png", non_color=True)
    if t_rgh:
        nt.links.new(t_rgh.outputs["Color"], bsdf.inputs["Roughness"])

    # Metallic: metallic.png -> BSDF Metallic (Non-Color).
    t_met = _tex("metallic.png", non_color=True)
    if t_met:
        nt.links.new(t_met.outputs["Color"], bsdf.inputs["Metallic"])

    # Height -> Bump -> BSDF Normal (Non-Color). Relief variant only; bump (not
    # true displacement) keeps the silhouette clean while showing relief.
    if use_height:
        t_hgt = _tex("height.png", non_color=True)
        if t_hgt:
            bump = nt.nodes.new("ShaderNodeBump")
            bump.inputs["Strength"].default_value = 1.0
            bump.inputs["Distance"].default_value = HEIGHT_SCALE
            nt.links.new(t_hgt.outputs["Color"], bump.inputs["Height"])
            # Chain: if a normal map is already on BSDF.Normal, route it into
            # the Bump node's Normal input so both effects compose.
            nrm_in = bsdf.inputs["Normal"]
            existing = nrm_in.links[0].from_node if nrm_in.links else None
            if existing is not None:
                nt.links.new(existing.outputs["Normal"], bump.inputs["Normal"])
            nt.links.new(bump.outputs["Normal"], nrm_in)
    return m


label = "Model" if (HAS_GLB or HAS_MODEL) else SHAPE.capitalize()

if HAS_GLB:
    # REAL 3D (Hunyuan3D-2.1): a single textured mesh with its OWN baked PBR
    # textures (base color / normal / metallic / roughness) and matching UVs.
    # Keep those baked materials — do NOT re-apply the flat procedural maps
    # (their UVs would not match the GLB's 3D unwrap). One centered object.
    _import_model_glb(label, 0.0)
elif HAS_MODEL:
    obj_a = _import_model_obj(label + "_Albedo", -1.3)
    obj_b = _import_model_obj(label + "_Relief",  1.3)
    mat_a = _new_mat("Mat_Base", use_height=False)    # full PBR (no height)
    mat_b = _new_mat("Mat_Relief", use_height=True)   # PBR + height bump
    obj_a.data.materials.clear(); obj_a.data.materials.append(mat_a)
    obj_b.data.materials.clear(); obj_b.data.materials.append(mat_b)
else:
    obj_a = _build_shape(label + "_Albedo", -1.3, relief=False)   # full PBR
    obj_b = _build_shape(label + "_Relief",  1.3, relief=True)    # PBR + height bump
    mat_a = _new_mat("Mat_Base", use_height=False)
    mat_b = _new_mat("Mat_Relief", use_height=True)
    obj_a.data.materials.clear(); obj_a.data.materials.append(mat_a)
    obj_b.data.materials.clear(); obj_b.data.materials.append(mat_b)

# Pack every texture image INTO the .blend so the file is self-contained:
# bpy.data.images.load() stores a REFERENCE with the absolute build-machine
# path; packing embeds the pixels so the .blend opens correctly on any
# artist machine (the PNGs stay in the pack too, as editable source maps).
# Match by BASENAME (not exact name): the two materials each reference the same
# map files, and any auto-suffixed duplicate (albedo.png.001) would otherwise
# be left as an unpacked external ref that breaks the .blend on another machine.
_MAP_NAMES = ("albedo.png", "height.png", "normal.png", "roughness.png", "metallic.png")
for _img in list(bpy.data.images):
    if _img.filepath and os.path.basename(_img.filepath) in _MAP_NAMES:
        try:
            _img.pack()
        except Exception:
            pass

# Save the .blend next to the pack folder.  wm.save_as_mainfile exists in
# Blender 4.x and 5.x, so use the canonical wm operator with a fallback.
_save_path = os.path.join(HERE, OUT_NAME + ".blend")
try:
    bpy.ops.wm.save_as_mainfile(filepath=_save_path)
except Exception:
    bpy.ops.file.save_as_mainfile(filepath=_save_path)
_src = "model.glb (REAL 3D)" if HAS_GLB else ("model.obj" if HAS_MODEL else SHAPE)
print(f"[viz-demo] saved {OUT_NAME}.blend ({_src}: {label})")
